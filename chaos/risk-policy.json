{
  "autonomy_level": "SUPERVISED",
  "autonomy_levels": {
    "ASSISTED": {
      "description": "Human approval required for all deployments and code changes",
      "auto_promotion": false,
      "max_low_risk_diff_lines": 0
    },
    "SUPERVISED": {
      "description": "Autonomous staging and testing; mandatory human approval gate for live production traffic",
      "auto_promotion": false,
      "max_low_risk_diff_lines": 150
    },
    "HANDS_OFF": {
      "description": "Fully autonomous pipeline progression for verified low-risk changes",
      "auto_promotion": true,
      "max_low_risk_diff_lines": 300
    }
  },
  "high_risk_patterns": [
    "auth",
    "payment",
    "schema",
    "migration",
    "secret",
    "iam",
    "infra/cloudrun"
  ],
  "max_low_risk_diff_lines": 150,
  "medium_risk_patterns": [
    "requirements.txt",
    "Dockerfile",
    "docker-compose",
    "flows/"
  ],
  "allowed_low_risk_prefixes": [
    "app/clients/",
    "app/resilience/",
    "tests/"
  ],
  "require_regression_test_in_tests": true
}
