{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IncidentDossier",
  "type": "object",
  "required": [
    "incident_id",
    "commit_sha",
    "fault",
    "observations",
    "confirmed_facts",
    "hypotheses",
    "evidence"
  ],
  "properties": {
    "incident_id": { "type": "string" },
    "project_path": { "type": "string" },
    "commit_sha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "pipeline_url": { "type": "string" },
    "test_run_id": { "type": "string" },
    "fault": {
      "type": "object",
      "required": ["type", "target", "profile_hash"],
      "properties": {
        "type": { "type": "string" },
        "target": { "type": "string" },
        "profile_name": { "type": "string" },
        "profile_hash": { "type": "string" },
        "latency_ms": { "type": "number" },
        "jitter_ms": { "type": "number" }
      }
    },
    "observations": {
      "type": "object",
      "required": ["health_check", "sla_breaches"],
      "properties": {
        "health_check": { "type": "string" },
        "total_probes": { "type": "integer" },
        "failed_probes": { "type": "integer" },
        "sla_breaches": { "type": "integer" },
        "p95_ms": { "type": "number" },
        "avg_ms": { "type": "number" }
      }
    },
    "confirmed_facts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "hypotheses": {
      "type": "array",
      "items": { "type": "string" }
    },
    "evidence": {
      "type": "object",
      "required": ["call_site", "log_excerpt"],
      "properties": {
        "failed_test": { "type": "string" },
        "call_site": { "type": "string" },
        "log_excerpt": { "type": "string" },
        "culprit_commit": { "type": ["string", "null"] }
      }
    },
    "deployment": {
      "type": "object"
    }
  }
}
